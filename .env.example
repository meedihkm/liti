# ─────────────────────────────────────────────────────────────
# Taqendurt — Robes Kabyles · Variables d'environnement
# Copier en .env puis adapter. AUCUN secret ne vit dans le code.
# ─────────────────────────────────────────────────────────────

# ── Base de données ──
# SQLite (démarrage rapide, volume Docker ./data) :
DATABASE_URL="file:/app/data/taqendurt.db"
# PostgreSQL (production — voir README §Déploiement) :
#   1. Dans prisma/schema.prisma : provider = "postgresql"
#   2. DATABASE_URL="postgresql://taqendurt:motdepasse@postgres:5432/taqendurt?schema=public"

# ── Site ──
# URL publique (SEO, Open Graph, sitemap) — sans slash final
NEXT_PUBLIC_SITE_URL="https://votre-domaine.dz"

# ── Sécurité / CSRF ──
# La protection repose sur un marqueur d'origine (en-tête
# X-Requested-With posé par le SPA) + Content-Type strict.
# Aucune variable à configurer — compatible reverse-proxies
# (Coolify / Traefik) sans réglage particulier.

# ── Admin ──
# Email de notification des nouvelles commandes (paramétrable aussi
# dans l'admin → Paramètres). Utilisé par le seed.
ADMIN_EMAIL="admin@votre-domaine.dz"

# ── SMTP (notifications email à l'admin) ──
# Sans ces variables, les emails sont journalisés en base (table
# MailLog, visibles dans l'admin) — mode dégradé explicite.
# SMTP_HOST="smtp.votre-fournisseur.dz"
# SMTP_PORT="587"
# SMTP_SECURE="false"          # true si port 465
# SMTP_USER="notifications@votre-domaine.dz"
# SMTP_PASS="mot-de-passe-smtp"
# SMTP_FROM="Taqendurt <notifications@votre-domaine.dz>"

# ── Docker / premier démarrage ──
# Seed des données de démonstration si la base est vide (8 produits,
# tissus, couleurs, 58 wilayas, 3 commandes, comptes de test)
SEED_DEMO="true"
