// ─────────────────────────────────────────────────────────────
// Robes Kabyles — Schéma de données (Prisma + SQLite)
// Note : SQLite ne supporte pas les enums ni les listes primitives,
// les statuts/JSON sont donc stockés en String et validés en code (Zod).
// Voir docs/ARCHITECTURE.md pour le diagramme relationnel complet.
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Authentification admin ────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String // bcrypt
  name         String
  role         String    @default("admin") // "admin" | "staff"
  createdAt    DateTime  @default(now())
  sessions     Session[]
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid()) // cookie httpOnly rk_session
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ── Catalogue ─────────────────────────────────────────────────

model Category {
  id            String    @id @default(cuid())
  slug          String    @unique
  name          String
  nameAr        String
  description   String    @default("")
  descriptionAr String    @default("")
  image         String    @default("")
  order         Int       @default(0)
  products      Product[]
}

model Product {
  id              String   @id @default(cuid())
  title           String
  titleAr         String
  description     String   @default("")
  descriptionAr   String   @default("")
  basePrice       Int // prix de base en DA
  customSizeFee   Int      @default(1500) // supplément sur-mesure
  leadTimeDays    Int      @default(14) // délai de confection estimé
  featured        Boolean  @default(false)
  visible         Boolean  @default(true)
  hasCustomLength Boolean  @default(false)
  occasion        String   @default("") // mariage | fiancailles | fete | quotidien
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  categoryId      String
  category        Category @relation(fields: [categoryId], references: [id])
  images          ProductImage[]
  fabrics         ProductFabric[]
  colors          ProductColor[]
  embroideries    ProductEmbroidery[]
  // Pas de relation Order → OrderItem : OrderItem ne conserve qu'un
  // snapshot (productId en String simple) pour rester stable dans le temps.
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String  @default("")
  order     Int     @default(0)
}

// Tissus (satin, soie, mlifa, velours, mousseline…)
model Fabric {
  id         String          @id @default(cuid())
  name       String
  nameAr     String
  image      String          @default("")
  priceExtra Int             @default(0)
  products   ProductFabric[]
}

model Color {
  id       String         @id @default(cuid())
  name     String
  nameAr   String
  hex      String
  products ProductColor[]
}

model EmbroideryOption {
  id         String              @id @default(cuid())
  name       String
  nameAr     String
  priceExtra Int                 @default(0)
  products   ProductEmbroidery[]
}

// Disponibilité tissu ↔ produit (+ supplément propre au produit,
// + couleurs autorisées pour ce tissu sur ce produit en JSON)
model ProductFabric {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  fabricId    String
  fabric      Fabric  @relation(fields: [fabricId], references: [id], onDelete: Cascade)
  priceExtra  Int     @default(0)
  colorsJson  String  @default("[]") // liste des colorId disponibles
}

model ProductColor {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorId   String
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)
}

model ProductEmbroidery {
  id           String            @id @default(cuid())
  productId    String
  product      Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  embroideryId String
  embroidery   EmbroideryOption  @relation(fields: [embroideryId], references: [id], onDelete: Cascade)
}

// ── Commandes ─────────────────────────────────────────────────
// OrderItem conserve un SNAPSHOT (noms, options, prix) pour que
// modifier le catalogue plus tard ne change pas les anciennes commandes.

model Order {
  id            String               @id @default(cuid())
  number        String               @unique // ex. RK-2026-0001
  status        String               @default("pending")
  // pending → validated → crafting → ready → shipped → delivered ; cancelled ; refused
  fullName      String
  phone         String
  email         String               @default("")
  wilayaCode    Int
  wilayaName    String
  commune       String
  address       String               @default("")
  deliveryMode  String               @default("home") // home | pickup
  shippingFee   Int                  @default(0)
  subtotal      Int                  @default(0)
  total         Int                  @default(0)
  note          String               @default("")
  internalNote  String               @default("")
  refusalReason String               @default("")
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  items         OrderItem[]
  history       OrderStatusHistory[]
  tracking      TrackingToken?
  advancements  OrderAdvancement[]
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  order            Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId        String  @default("")
  productName      String
  productImage     String  @default("")
  fabricName       String  @default("")
  colorName        String  @default("")
  colorHex         String  @default("")
  embroideryJson   String  @default("[]") // [{ name, nameAr, priceExtra }]
  size             String  @default("") // S…XXL ou "sur-mesure"
  measurementsJson String  @default("{}")
  length           String  @default("") // courte | mi-longue | longue
  quantity         Int     @default(1)
  unitPrice        Int     @default(0) // base + suppléments (hors livraison)
  lineTotal        Int     @default(0)
  note             String  @default("")
}

model OrderStatusHistory {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String   @default("")
  actor     String   @default("system") // "system" | nom de l'admin
  createdAt DateTime @default(now())
}

// ── Livraison (frais par wilaya) ──────────────────────────────

model ShippingRate {
  wilayaCode Int     @id
  homePrice  Int     @default(600)
  active     Boolean @default(true)
}

// ── Contact ───────────────────────────────────────────────────

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String   @default("")
  email     String   @default("")
  subject   String   @default("")
  message   String
  status    String   @default("new") // new | read | handled
  createdAt DateTime @default(now())
}

// ── Paramètres du site (clé/valeur) ───────────────────────────

model SiteSetting {
  key   String @id
  value String
}

// ── Journal des emails (notification admin) ───────────────────
// Si SMTP_HOST n'est pas configuré, l'email est journalisé ici
// au lieu d'être envoyé (mode dégradé explicite).

model MailLog {
  id        String   @id @default(cuid())
  to        String
  subject   String
  body      String
  status    String   @default("logged") // sent | logged | error
  error     String   @default("")
  createdAt DateTime @default(now())
}

// ── Galerie/Vitrine (Lookbook) ────────────────────────────────
// Les visuels de vitrine : lookbooks thématiques, collections, 
// photos d'inspiration, mood boards, etc.

model Gallery {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  titleAr       String
  description   String        @default("")
  descriptionAr String        @default("")
  coverImage    String        @default("") // image principale
  type          String        @default("lookbook") // lookbook | collection | inspiration
  visible       Boolean       @default(true)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  images        GalleryImage[]
}

model GalleryImage {
  id          String   @id @default(cuid())
  galleryId   String
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)
  url         String
  alt         String   @default("")
  caption     String   @default("")
  captionAr   String   @default("")
  productId   String   @default("") // lien vers produit si applicable
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

// ContentBlock : sections éditoriales dynamiques pour la page galerie
// (bannières, texte marketing, call-to-action, etc.)
model ContentBlock {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String   @default("")
  titleAr     String   @default("")
  content     String   @default("") // HTML ou markdown
  contentAr   String   @default("")
  type        String   @default("hero") // hero | banner | text | cta
  visible     Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ── Système de devis (sur-mesure) ─────────────────────────────
// Les clients peuvent demander un devis pour une robe sur-mesure.
// Système d'échanges de messages et photos entre client et admin.

model Quote {
  id                String         @id @default(cuid())
  number            String         @unique // ex. DEV-2026-0001
  status            String         @default("pending") 
  // pending | in_discussion | quoted | accepted | rejected | converted_to_order
  customerName      String
  customerPhone     String
  customerEmail     String         @default("")
  wilayaCode        Int
  wilayaName        String
  commune           String         @default("")
  
  // Détails de la demande
  productType       String         @default("") // type de robe souhaité
  description       String         @default("") // description libre du client
  referenceImages   String         @default("[]") // JSON array d'URLs d'images de référence
  fabricPreference  String         @default("")
  colorPreference   String         @default("")
  measurementsJson  String         @default("{}")
  budget            Int            @default(0) // budget indicatif
  deadline          String         @default("") // date souhaitée
  
  // Réponse admin
  estimatedPrice    Int            @default(0)
  estimatedDays     Int            @default(0)
  adminNotes        String         @default("")
  
  orderId           String         @default("") // si converti en commande
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  
  messages          QuoteMessage[]
  history           QuoteStatusHistory[]
}

model QuoteMessage {
  id          String   @id @default(cuid())
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sender      String   // "customer" | "admin"
  senderName  String   @default("")
  message     String
  attachments String   @default("[]") // JSON array d'URLs (photos, docs)
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model QuoteStatusHistory {
  id        String   @id @default(cuid())
  quoteId   String
  quote     Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  status    String
  note      String   @default("")
  actor     String   @default("system") // "system" | "customer" | nom de l'admin
  createdAt DateTime @default(now())
}

// ── Profil client (optionnel) ─────────────────────────────────
// Permet de sauvegarder les infos et mesures pour les clients réguliers

model CustomerProfile {
  id               String   @id @default(cuid())
  phone            String   @unique // identifiant principal
  name             String
  email            String   @default("")
  wilayaCode       Int      @default(0)
  wilayaName       String   @default("")
  commune          String   @default("")
  address          String   @default("")
  measurementsJson String   @default("{}")
  notes            String   @default("") // préférences, remarques
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ── Suivi de commande avec photos d'avancement ────────────────

model TrackingToken {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  token     String   @unique // token public pour tracking sans compte
  createdAt DateTime @default(now())
}

model OrderAdvancement {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stage       String   // fabric_cutting | embroidery | assembly | finishing | quality_check
  title       String
  titleAr     String
  description String   @default("")
  photos      String   @default("[]") // JSON array d'URLs
  progress    Int      @default(0) // 0-100%
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Notifications push (PWA)
model PushSubscription {
  id           String   @id @default(cuid())
  userId       String   @default("") // optionnel, pour clients avec compte
  orderId      String   @default("") // optionnel, pour suivre une commande
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String   @default("")
  createdAt    DateTime @default(now())
}

// ── Phase 4: Enrichissements back-office ──────────────────────

// Codes promo
model PromoCode {
  id          String   @id @default(cuid())
  code        String   @unique
  type        String   // percentage | fixed
  value       Int      // pourcentage ou montant fixe
  minAmount   Int      @default(0) // montant minimum de commande
  maxUses     Int      @default(0) // 0 = illimité
  usedCount   Int      @default(0)
  validFrom   DateTime @default(now())
  validUntil  DateTime
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Blog posts
model BlogPost {
  id            String   @id @default(cuid())
  slug          String   @unique
  title         String
  titleAr       String
  excerpt       String   @default("")
  excerptAr     String   @default("")
  content       String   @default("") // HTML or Markdown
  contentAr     String   @default("")
  coverImage    String   @default("")
  author        String   @default("Taqendurt")
  tags          String   @default("[]") // JSON array
  published     Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Rendez-vous en atelier
model Appointment {
  id            String   @id @default(cuid())
  customerName  String
  customerPhone String
  customerEmail String   @default("")
  date          DateTime
  timeSlot      String   // 10:00-11:00, 11:00-12:00, etc.
  type          String   @default("fitting") // fitting | consultation | pickup
  status        String   @default("pending") // pending | confirmed | completed | cancelled
  notes         String   @default("")
  orderId       String   @default("") // optionnel, lié à une commande
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Avis clients
model Review {
  id            String   @id @default(cuid())
  orderId       String   @default("")
  customerName  String
  rating        Int      // 1-5 étoiles
  comment       String   @default("")
  photos        String   @default("[]") // JSON array d'URLs
  published     Boolean  @default(false)
  publishedAt   DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
