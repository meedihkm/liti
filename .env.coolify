# ─────────────────────────────────────────────────────────────
# Template de variables d'environnement pour Coolify
# Copiez ces variables dans l'onglet "Environment" de Coolify
# ─────────────────────────────────────────────────────────────

# ── Base de données (SQLite par défaut) ──
DATABASE_URL=file:/app/data/taqendurt.db

# ── URL du site (OBLIGATOIRE - remplacer par votre domaine) ──
NEXT_PUBLIC_SITE_URL=https://votre-domaine.dz

# ── Email admin (OBLIGATOIRE) ──
ADMIN_EMAIL=admin@votre-domaine.dz

# ── Seed de démonstration ──
# true = Charge les données de démo au premier démarrage
# false = Base vide (pour production)
SEED_DEMO=true

# ── Configuration SMTP (OPTIONNEL) ──
# Sans ces variables, les emails sont journalisés en base de données
# Décommentez et configurez pour activer l'envoi réel d'emails

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=votre-email@gmail.com
# SMTP_PASS=votre-mot-de-passe-application
# SMTP_FROM=Taqendurt <notifications@votre-domaine.dz>

# ── Notes de déploiement ──
# 1. Le port 3000 est géré automatiquement par Coolify/Traefik
# 2. Les volumes (uploads, appdata) sont créés automatiquement
# 3. SSL/TLS est géré par Coolify (Let's Encrypt)
# 4. Après déploiement, accédez à /admin avec :
#    Email: admin@taqendurt.dz
#    Pass: motdepasse
#    ⚠️ Changez ce mot de passe immédiatement !
